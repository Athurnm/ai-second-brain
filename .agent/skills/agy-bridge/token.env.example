# Copy this file to `token.env` (same folder) and paste your tokens.
# token.env is gitignored; this .example file is safe to commit.

# z.ai GLM Coding Plan token.
# Get it: subscribe at https://z.ai/subscribe -> dashboard -> API key / token.
# Billing is the flat subscription (Lite/Pro/Max), NOT metered per-token.
ZAI_API_TOKEN=paste-your-zai-coding-plan-token-here

# Kimi Code SUBSCRIPTION token (flat monthly, Anthropic-compatible endpoint).
# Get it: Kimi Code Console https://www.kimi.com/code/console -> create API Key (shown once).
# Billing is the flat Kimi membership tier, NOT metered per-token.
KIMI_CODE_TOKEN=paste-your-kimi-code-console-key-here
